# Never commit real secrets.
# DATASET_PATH points to the directory containing the four dataset files.
# OPENAI_API_KEY may be empty: deterministic fallback remains available.
# `serve` and Alembic load this file when it exists.
# Variables already set in the process take priority.
# Allowed database names: career_quest_dev, career_quest_test.

DATABASE_URL=postgresql+psycopg://career_quest:CHANGE_ME@127.0.0.1:5432/career_quest_dev
DATASET_PATH=C:/path/to/career_quest_dataset
ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
COOKIE_SECURE=false
SESSION_TTL_HOURS=12

DEMO_EMPLOYEE_ONE_USERNAME=
DEMO_EMPLOYEE_ONE_PASSWORD=
DEMO_EMPLOYEE_ONE_ID=
DEMO_EMPLOYEE_TWO_USERNAME=
DEMO_EMPLOYEE_TWO_PASSWORD=
DEMO_EMPLOYEE_TWO_ID=
DEMO_HR_USERNAME=
DEMO_HR_PASSWORD=

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra
OPENAI_TIMEOUT_SECONDS=7
